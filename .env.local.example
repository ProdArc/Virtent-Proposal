# Supabase — credenciais só de servidor. Nunca prefixar com NEXT_PUBLIC_:
# o conteúdo das propostas é confidencial e só deve ser lido no servidor,
# nunca exposto ao browser do cliente.
#
# URL e Service Role Key ficam em Project Settings > API no dashboard do Supabase.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Senha de login (usuário "ryan") das áreas internas — ver lib/auth.ts.
ADMIN_PASSWORD=

# Acesso do Lucas (login "lucas") — ver lib/auth.ts.
LUCAS_PASSWORD=

# Acesso do Fratti (login "fratti") — ver lib/auth.ts.
FRATTI_PASSWORD=

# Chave usada pra assinar o cookie de sessão do login (HMAC) — ver lib/auth.ts.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Domínio público e estável do site (SEM barra no final), usado só pra montar
# o link exibido em /propostas/nova. Sem isso, o link copiado usa a URL da aba
# atual — que na Vercel pode ser uma URL de deployment específico (com hash),
# protegida por login da Vercel e inacessível a quem não tem acesso ao projeto.
# Prefixo NEXT_PUBLIC_ é intencional aqui: não é segredo, e precisa ser lido
# no navegador (o botão "Copiar link" roda no client).
NEXT_PUBLIC_SITE_URL=https://virtent-proposal.vercel.app

# Envio de cobrança por e-mail (implantação e mensalidade) — ver lib/email.ts.
# API key criada em resend.com/api-keys. RESEND_FROM_EMAIL precisa ser um
# endereço de um domínio verificado no Resend (resend.com/domains), senão o
# envio falha — não dá pra usar um domínio qualquer.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Virtent <cobranca@seudominio.com>"
